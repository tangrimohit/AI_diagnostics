OLLAMA_HOST=http://localhost:11434
WIKI_PATH=./wiki
RAW_PATH=./raw
MODEL_FAST=gemma3:4b
MODEL_DEEP=gemma4:e2b
LOG_LEVEL=INFO

# Outbound email (feedback confirmations + nudges). Dry-run unless ENABLED + key.
AKARI_EMAIL_ENABLED=false
AKARI_EMAIL_PROVIDER=resend
RESEND_API_KEY=
AKARI_EMAIL_FROM=AKARI <akari@your-domain>
AKARI_EMAIL_REPLY_TO=
AKARI_EMAIL_BCC=
AKARI_PUBLIC_BASE_URL=https://akari.your-domain
# Nudge timing. Production: 24 / 3600. Demo (near-instant): 0 / 60.
AKARI_NUDGE_DELAY_HOURS=24
AKARI_NUDGE_SWEEP_SECONDS=3600
