<mxfile host="app.diagrams.net">
  <diagram name="AKARI Azure Target Architecture" id="akari-azure">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;AKARI Diagnostic Assistant – Proposed Azure Target Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Maps current local components (FastAPI, Ollama, SQLite, wiki) to Epson-governed Azure services&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="users" value="Service engineers / partners&lt;br&gt;(browser)" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="60" height="80" as="geometry" />
        </mxCell>

        <mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;SSO, MFA, Conditional Access,&lt;br&gt;app roles, partner (B2B) access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;" vertex="1" parent="1">
          <mxGeometry x="180" y="110" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="afd" value="&lt;b&gt;Azure Front Door + WAF&lt;/b&gt;&lt;br&gt;TLS, DDoS, rate limiting,&lt;br&gt;replaces Cloudflare Tunnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;" vertex="1" parent="1">
          <mxGeometry x="180" y="300" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="vnet" value="&lt;b&gt;Azure Virtual Network (Epson-managed subscription)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#0078d4;dashed=1;startSize=28;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="70" width="780" height="700" as="geometry" />
        </mxCell>

        <mxCell id="appsn" value="App subnet" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;startSize=24;" vertex="1" parent="vnet">
          <mxGeometry x="20" y="50" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="aca" value="&lt;b&gt;Azure Container Apps&lt;/b&gt;&lt;br&gt;FastAPI API + web UI&lt;br&gt;(diagnose, feedback, admin)&lt;br&gt;Validates Entra token / injects&lt;br&gt;identity (replaces email header)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="appsn">
          <mxGeometry x="30" y="40" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="job" value="&lt;b&gt;Container Apps Job&lt;/b&gt;&lt;br&gt;Ingest / extract / draft pipeline&lt;br&gt;Scheduled health check &amp;amp; backups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="appsn">
          <mxGeometry x="30" y="170" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="infsn" value="Inference subnet (no internet egress)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;startSize=24;" vertex="1" parent="vnet">
          <mxGeometry x="20" y="390" width="320" height="270" as="geometry" />
        </mxCell>
        <mxCell id="gpu" value="&lt;b&gt;GPU VM / VM Scale Set (NC-series)&lt;/b&gt;&lt;br&gt;Ollama runtime&lt;br&gt;gemma3:4b (fast), gemma4:e2b (deep)&lt;br&gt;Priority failover across hosts&lt;br&gt;(OLLAMA_HOSTS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="infsn">
          <mxGeometry x="30" y="50" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nsg" value="NSGs: only App subnet → port 11434" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="infsn">
          <mxGeometry x="30" y="185" width="260" height="30" as="geometry" />
        </mxCell>

        <mxCell id="datasn" value="Data subnet (Private Endpoints)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;startSize=24;" vertex="1" parent="vnet">
          <mxGeometry x="400" y="50" width="360" height="440" as="geometry" />
        </mxCell>
        <mxCell id="sql" value="&lt;b&gt;Azure Database for PostgreSQL /&lt;br&gt;Azure SQL&lt;/b&gt;&lt;br&gt;Audit log, feedback, user hash&lt;br&gt;(replaces SQLite monitor.db)&lt;br&gt;Geo-redundant backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="datasn">
          <mxGeometry x="30" y="40" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="blob" value="&lt;b&gt;Azure Files / Blob Storage (ZRS)&lt;/b&gt;&lt;br&gt;Approved wiki pages, raw service docs,&lt;br&gt;uploads (IPS logs, photos)&lt;br&gt;Versioning, soft delete, retention policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="datasn">
          <mxGeometry x="30" y="170" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kv" value="&lt;b&gt;Azure Key Vault&lt;/b&gt;&lt;br&gt;Secrets, salts, connection strings&lt;br&gt;(Managed Identity access)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="datasn">
          <mxGeometry x="30" y="300" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="gh" value="&lt;b&gt;GitHub Enterprise&lt;/b&gt;&lt;br&gt;Repo, Actions CI/CD,&lt;br&gt;Dependabot, code scanning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="540" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="acr" value="&lt;b&gt;Azure Container Registry&lt;/b&gt;&lt;br&gt;Signed images, vulnerability scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;" vertex="1" parent="1">
          <mxGeometry x="180" y="680" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mon" value="&lt;b&gt;Azure Monitor + Log Analytics&lt;/b&gt;&lt;br&gt;App Insights, alerts (GPU, errors),&lt;br&gt;audit log access control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1290" y="110" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="def" value="&lt;b&gt;Microsoft Defender for Cloud&lt;/b&gt;&lt;br&gt;Posture, threat detection,&lt;br&gt;Azure Policy compliance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1290" y="240" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bak" value="&lt;b&gt;Azure Backup / Recovery Services Vault&lt;/b&gt;&lt;br&gt;Replaces weekly VACUUM INTO snapshots;&lt;br&gt;tested restore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1290" y="370" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="acs" value="&lt;b&gt;Azure Communication Services Email&lt;/b&gt;&lt;br&gt;Escalation drafts / alerts&lt;br&gt;(replaces external Resend API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1290" y="500" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="HTTPS" style="endArrow=classic;html=1;" edge="1" parent="1" source="users" target="afd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Sign-in + MFA (OIDC)" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="afd" target="entra">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Authenticated traffic (Private Link)" style="endArrow=classic;html=1;" edge="1" parent="1" source="afd" target="aca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Inference (HTTP :11434)" style="endArrow=classic;html=1;" edge="1" parent="1" source="aca" target="gpu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Audit / feedback" style="endArrow=classic;html=1;" edge="1" parent="1" source="aca" target="sql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Wiki retrieval / uploads" style="endArrow=classic;html=1;" edge="1" parent="1" source="aca" target="blob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Secrets (Managed Identity)" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="aca" target="kv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Ingest → wiki (human-reviewed)" style="endArrow=classic;html=1;" edge="1" parent="1" source="job" target="blob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="Push / PR" style="endArrow=classic;html=1;" edge="1" parent="1" source="gh" target="acr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="Deploy images" style="endArrow=classic;html=1;" edge="1" parent="1" source="acr" target="vnet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Logs / metrics" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="vnet" target="mon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="Backup" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="vnet" target="bak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="Email" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="vnet" target="acs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="Posture" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="vnet" target="def">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Key design points&lt;/b&gt;&lt;br&gt;• AI inference stays inside the VNet – no external AI service&lt;br&gt;• Identity enforced by Entra ID; app no longer trusts a raw header&lt;br&gt;• Per-partner data separation via tenant ID on every record&lt;br&gt;• All PaaS access via Private Endpoints + Managed Identity&lt;br&gt;• Knowledge pages published only after human review" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#fffbe6;strokeColor=#d6b656;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="790" width="780" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
